<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 даёт WinRT-проекцию Windows.Media.Ocr (OCR области экрана) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PravVyd</AssemblyName>
    <RootNamespace>PravVyd</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>Правильный выделяльщик</Product>
    <!-- WinForms DPI bootstrap (SetHighDpiMode) never runs — нет WinForms message loop, только NotifyIcon. DPI задаёт WPF через манифест. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray needs WinForms NotifyIcon, but its implicit usings clash with WPF (Point/Clipboard/Application). Keep WinForms types file-local. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- рендер html «как сайт» и svg через движок Edge Chromium -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- Markdown → HTML для оформленного превью .md -->
    <PackageReference Include="Markdig" Version="0.*" />
    <!-- HTML (из буфера) → Markdown: сохраняем оформление выделения при генерации .md -->
    <PackageReference Include="ReverseMarkdown" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- частотные словари для авто-раскладки (WordDictionary читает их как embedded-ресурс) -->
    <EmbeddedResource Include="Resources\en_words.txt" />
    <EmbeddedResource Include="Resources\ru_words.txt" />
  </ItemGroup>

</Project>
