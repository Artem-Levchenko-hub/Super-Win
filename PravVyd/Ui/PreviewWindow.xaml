<Window x:Class="PravVyd.Ui.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Превью"
        Width="480" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Окно прозрачное → за ним DWM acrylic (матовое стекло). Root — видимая карточка, её и анимируем.
         Рамок нет: форму держат скруглённые углы DWM + системная тень. -->
    <Grid>
        <Border x:Name="Root"
                CornerRadius="8"
                Background="#2C0A0A12"
                BorderThickness="0"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="0.5" ScaleY="0.5" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок: только имя файла -->
                <TextBlock x:Name="TitleText" Grid.Row="0"
                           Foreground="#E6FFFFFF" FontSize="12.5"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="20,16,20,11" />

                <!-- Контент напрямую на стекле, без рамок-подложек -->
                <Grid x:Name="Host" Grid.Row="1" Margin="14,0,14,0" ClipToBounds="True" />

                <!-- Подсказка: едва заметная -->
                <TextBlock Grid.Row="2"
                           Foreground="#40FFFFFF" FontSize="10" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Text="Esc · Пробел — закрыть" Margin="0,9,0,13" />
            </Grid>
        </Border>
    </Grid>
</Window>
