<Window x:Class="PravVyd.Ui.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Превью"
        Width="920" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E28">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26263A" Padding="14,10">
            <TextBlock x:Name="TitleText"
                       Foreground="#FFE8E8F0" FontSize="14" FontFamily="Segoe UI"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#26263A" Padding="14,5">
            <TextBlock Foreground="#80FFFFFF" FontSize="11" FontFamily="Segoe UI"
                       Text="Esc или Пробел — закрыть" />
        </Border>
        <Grid x:Name="Host" Margin="6" />
    </DockPanel>
</Window>
