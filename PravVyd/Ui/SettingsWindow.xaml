<Window x:Class="PravVyd.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правильный выделяльщик — настройки"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <StackPanel Margin="18">
        <TextBlock Text="Форматы" FontWeight="Bold" Margin="0,0,0,6" />
        <CheckBox x:Name="MdCheck" Content="Markdown (.md)" Margin="0,2" Checked="Format_Changed" Unchecked="Format_Changed" />
        <CheckBox x:Name="PdfCheck" Content="PDF (.pdf)" Margin="0,2" Checked="Format_Changed" Unchecked="Format_Changed" />
        <CheckBox x:Name="DocxCheck" Content="Word (.docx)" Margin="0,2" Checked="Format_Changed" Unchecked="Format_Changed" />

        <TextBlock Text="Куда сохранять файлы" FontWeight="Bold" Margin="0,14,0,6" />
        <RadioButton x:Name="TempRadio" GroupName="loc" Content="Временная папка" Margin="0,2" Checked="Location_Changed" />
        <RadioButton x:Name="DocsRadio" GroupName="loc" Content="Документы\PravVyd" Margin="0,2" Checked="Location_Changed" />
        <RadioButton x:Name="CustomRadio" GroupName="loc" Content="Своя папка:" Margin="0,2" Checked="Location_Changed" />
        <DockPanel Margin="20,4,0,0">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Обзор…" Padding="10,2" Margin="6,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>

        <CheckBox x:Name="AutoStartCheck" Content="Запускать при входе в Windows" Margin="0,16,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />

        <Button Content="Готово" HorizontalAlignment="Right" Padding="16,5" Margin="0,18,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
