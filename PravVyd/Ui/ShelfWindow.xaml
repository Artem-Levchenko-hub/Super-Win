<Window x:Class="PravVyd.Ui.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полка"
        Width="92"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#E61E1E28" CornerRadius="14,0,0,14"
            BorderBrush="#3A3A52" BorderThickness="1,1,0,1"
            Padding="8" AllowDrop="True">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="📥 Полка" Foreground="#A0FFFFFF"
                       FontSize="11" FontFamily="Segoe UI Emoji"
                       HorizontalAlignment="Center" Margin="0,2,0,8" />
            <Grid>
                <TextBlock x:Name="Hint" Text="Перетащи&#x0a;файл сюда"
                           Foreground="#66FFFFFF" FontSize="11" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Items" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
