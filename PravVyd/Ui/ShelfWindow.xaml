<Window x:Class="PravVyd.Ui.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полка"
        Width="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border CornerRadius="16,0,0,16" BorderThickness="1,1,0,1" AllowDrop="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F22A2A3C" Offset="0" />
                <GradientStop Color="#F2161620" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#557C5CFF" Offset="0" />
                <GradientStop Color="#5533C6FF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- акцентная полоса слева -->
            <Rectangle Grid.Column="0" Margin="0,10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7C5CFF" Offset="0" />
                        <GradientStop Color="#33C6FF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <DockPanel Grid.Column="1" Margin="8,8,8,10">
                <TextBlock DockPanel.Dock="Top" Text="📥 Полка" Foreground="#D0FFFFFF"
                           FontSize="11" FontFamily="Segoe UI Emoji" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,2,0,8" />
                <Grid>
                    <TextBlock x:Name="Hint" Text="брось&#x0a;файл сюда"
                               Foreground="#66FFFFFF" FontSize="11" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Items" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
