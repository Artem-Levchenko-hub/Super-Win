<Window x:Class="PravVyd.Ui.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правильный выделяльщик"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Window.Resources>
        <Style x:Key="FormatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="Background" Value="#2E2E44" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#5563E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FormatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9A9AB8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#1B1B28" Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Grip" Text="⠿" Foreground="#6A6A88" FontSize="16"
                           Margin="4,0,6,0" VerticalAlignment="Center" Cursor="SizeAll"
                           MouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove" MouseLeftButtonUp="Grip_MouseUp" />
                <Button x:Name="MdButton" Style="{StaticResource FormatButton}" Content="MD" Click="Md_Click" />
                <Button x:Name="PdfButton" Style="{StaticResource FormatButton}" Content="PDF" Click="Pdf_Click" />
                <Button x:Name="DocxButton" Style="{StaticResource FormatButton}" Content="DOCX" Click="Docx_Click" />
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click" />
            </StackPanel>

            <Border x:Name="Toast" CornerRadius="9" Background="#222236" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="#E8E8F0" FontSize="13" FontWeight="SemiBold"
                           Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
